# ── Environment Configuration (Non-secret placeholders only) ──────
# Copy to .env and fill in actual values

# Dataset
MOVIELENS_DIR=d:/setup/Database/ml-25m
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# Mode: set to False for full 25M dataset
DEV_MODE=True
DEV_SAMPLE_SIZE=1000000
DEV_RANDOM_SEED=42

# Spark
SPARK_DRIVER_MEMORY=4g
SPARK_APP_NAME=RecEngineDataProcessing

# Model
EMBEDDING_DIM=64
RETRIEVAL_EPOCHS=5
RETRIEVAL_BATCH_SIZE=4096
RANKING_EPOCHS=5
RANKING_BATCH_SIZE=4096
RANKING_RELEVANCE_THRESHOLD=3.5

# FAISS
FAISS_NUM_CANDIDATES=200

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=3600
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# API & Serving
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Streamlit UI
STREAMLIT_SERVER_PORT=8501

# Triton (Phase 5)
TRITON_URL=localhost:8001
TRITON_ENABLED=False

# OMDb API (Movie Posters)
OMDB_API_KEY=your_key_here
OMDB_TIMEOUT=3.0
